id=com.template.lsposed
name=LSPosed Universal Template
version=v0.2.0
versionCode=2
author=YourName
description=Modern libxposed API 102 template for Vector and LSPatch 1.2, with movable overlay and optional ShadowHook native scaffold for authorized testing.
minApiVersion=102
targetApiVersion=102
staticScope=true
# Native hooks, worker threads, and Activity lifecycle callbacks need explicit teardown before hot reload is safe.
autoHotReload=false
# Protective catches/logs hooker exceptions and lets the original call continue.
exceptionMode=protective
